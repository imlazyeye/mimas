use offers::Offer;
use run::{Event, Mode, Run};
use ui;
use weapons::Weapon;
use weapons::bases;

// Frame counts at 60 Hz: wait after a death, and debounce upgrade confirmation. These are
// scene time, not the run's survival clock.
const RESTART_DELAY = 60;
const CHOOSE_DELAY = 20;

struct Choices {
    offers: [Offer],
    cursor: int,
}

struct Arsenal {
    weapons: [Weapon],
    /// The slot of the menu's grid that is lit, which may be an empty one.
    cursor: int,
}

/// Primary controller struct to drive the game.
struct Game {
    /// The currently selected Scene.
    scene: Scene,
    /// Active data for the current run.
    run: Run,
    /// Ticks since the current scene has started.
    scene_tick: int,
    /// The longest a user has gotten through a run.
    best: int,
}

impl Game {
    /// Creates a new Game with default values for the title screen.
    fn new() -> Self {
        Self {
            scene = Scene::Title,
            run = Run::new(Mode::Normal),
            scene_tick = 0,
            best = 0,
        }
    }

    /// Per-tick update for the game.
    fn update(self) {
        self.scene_tick += 1;
        match self.scene {
            Scene::Title => self.title(),
            Scene::Arming(arsenal) => self.arm(arsenal),
            Scene::Playing => self.play(),
            Scene::LevelUp(choices) => self.choose(choices),
            Scene::Paused => {
                const ANY = [Button::Start, Button::A, Button::B, Button::X, Button::Y];
                for button in ANY {
                    if input::pressed(button) {
                        self.enter(Scene::Playing);
                        break;
                    }
                }
            },
            Scene::Dead => {
                if self.scene_tick > RESTART_DELAY && input::pressed(Button::Start) {
                    self.enter(Scene::Title);
                }
            },
        }
    }

    /// Per tick draw callback for the game.
    fn draw(self) {
        if self.scene == Scene::Title {
            ui::title(self.scene_tick, self.best);
            return;
        }

        // draw the world
        self.run.draw();

        // render the ui
        ui::hud(self.run);
        match self.scene {
            Scene::Arming(arsenal) => ui::arsenal(arsenal.weapons, arsenal.cursor),
            Scene::LevelUp(choices) => ui::level_up(self.run, choices.offers, choices.cursor),
            Scene::Paused => ui::paused(self.run),
            Scene::Dead => ui::finished("YOU DIED", Color::Red, self.run, self.scene_tick > RESTART_DELAY),
            Scene::Title | Scene::Playing => {},
        }
    }

    /// Executes the logic for the title menu. X and Y are the undrawn debug starts.
    fn title(self) {
        if input::pressed(Button::Start) {
            self.begin(Mode::Normal);
        } else if input::pressed(Button::X) {
            self.begin(Mode::Stress);
        } else if input::pressed(Button::Y) {
            self.begin(Mode::Lab);
        }
    }

    /// Moves around the weapon menu. An empty slot can be stood on, but there's nothing to take.
    fn arm(self, arsenal: Arsenal) {
        let slots = ui::ARSENAL_COLS * ui::ARSENAL_ROWS;
        if input::pressed(Button::Right) {
            arsenal.cursor = (arsenal.cursor + 1) % slots;
        }
        if input::pressed(Button::Left) {
            arsenal.cursor = (arsenal.cursor + slots - 1) % slots;
        }
        if input::pressed(Button::Down) {
            arsenal.cursor = (arsenal.cursor + ui::ARSENAL_COLS) % slots;
        }
        if input::pressed(Button::Up) {
            arsenal.cursor = (arsenal.cursor + slots - ui::ARSENAL_COLS) % slots;
        }
        let pressed = input::pressed(Button::A) || input::pressed(Button::Start);
        if pressed && arsenal.cursor < arsenal.weapons.len() {
            self.run.weapons.push(arsenal.weapons[arsenal.cursor]);
            self.enter(Scene::Playing);
        }
    }

    /// Executes the logic for an active run.
    fn play(self) {
        // the stress run can't pause, since the scripted input presses Start at random
        if input::pressed(Button::Start) && self.run.mode != Mode::Stress {
            self.enter(Scene::Paused);
            return;
        }

        // process signals from the run
        match self.run.update() {
            Event::Nothing => {},
            Event::LevelUp => {
                let offers = Offer::roll(self.run.player, self.run.weapons);
                self.enter(Scene::LevelUp(Choices { offers, cursor = 0 }));
            },
            Event::Died => {
                self.best = self.best.max(self.run.t);
                self.enter(Scene::Dead);
            },
        }
    }

    fn choose(self, choices: Choices) {
        let n = choices.offers.len();
        if input::pressed(Button::Down) {
            choices.cursor = (choices.cursor + 1) % n;
        }
        if input::pressed(Button::Up) {
            choices.cursor = (choices.cursor + n - 1) % n;
        }
        // a short wait, so a button that was already down doesn't pick for the player
        let pressed = input::pressed(Button::A) || input::pressed(Button::Start);
        if self.scene_tick > CHOOSE_DELAY && pressed {
            choices.offers[choices.cursor].apply(self.run.player, self.run.weapons);
            self.enter(Scene::Playing);
        }
    }

    fn begin(self, mode: Mode) {
        self.run = Run::new(mode);
        if mode != Mode::Normal {
            self.enter(Scene::Playing);
            return;
        }
        // a pact doesn't promise the order of its implementers, and a menu needs one that stays put
        let weapons = bases();
        weapons.sort_by_int(for weapon in weapons collect weapon.ICON.id());
        self.enter(Scene::Arming(Arsenal { weapons, cursor = 0 }));
    }

    fn enter(self, scene: Scene) {
        self.scene = scene;
        self.scene_tick = 0;
    }
}

/// The state the game can find itself within.
enum Scene {
    Title,
    Arming(Arsenal), // the weapon menu, which a normal run waits in until it has a weapon
    Playing,
    LevelUp(Choices), // offers and cursor exist only while choosing an upgrade
    Paused,
    Dead,
}

let game = Game::new();
luna::update(|| game.update());
luna::draw(|| game.draw());
