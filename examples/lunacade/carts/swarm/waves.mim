module waves;

use std::math::{TAU, Vec2};

use enemies::{Bat, EnemyKind, Lich};
use horde::Horde;
use player::Player;

// a minute of play, in frames
const MINUTE = 3600;

// the run is over when the lich falls, and it shows up at the ten minute mark
pub const BOSS_AT = 10 * MINUTE;

// most enemies that are out at once
pub const CROWD = 300;
const INITIAL = 8;
const PER_MINUTE = 24;
const BOSS_ESCORT = 40;
const MOST_SPAWN = 6; // spread catch-up work across frames instead of spawning a whole wave

// how many enemies the swarm tries to keep alive, and which kinds it draws them from
pub struct Waves {
    // what it draws kinds from, with the common ones listed more than once
    mix: [EnemyKind],
    summoned: bool,
}

impl Waves {
    pub fn new() -> Self {
        Self { mix = Waves::mix_at(0), summoned = false }
    }

    // `t` is the frames since the run began. `stress` keeps the crowd at its limit
    pub fn update(self, horde: Horde, p: Player, t: int, stress: bool) {
        let minute = t ~/ MINUTE;
        if t % MINUTE == 0 && !stress {
            self.mix = Waves::mix_at(minute);
        }
        if t >= BOSS_AT && !self.summoned && !stress {
            self.summoned = true;
            horde.boss = Waves::spawn(horde, p, Lich::new(), 1.0);
        }
        let want = if stress {
            CROWD
        } else if self.summoned {
            BOSS_ESCORT
        } else {
            (INITIAL + PER_MINUTE * minute).min(CROWD)
        };
        // a few at a time, and quicker the more it is behind
        let behind = want - horde.len();
        if behind > 0 && (stress || t % 2 == 0) {
            let tough = 1.0 + 0.1 * minute.to_float();
            // Each twenty missing enemies adds one spawn, capped at six per update.
            for _ in (1 + behind ~/ 20).min(MOST_SPAWN) {
                Waves::spawn(horde, p, self.mix.choose()!, tough);
            }
        }
        // a pack of bats all at once, now and then
        if minute >= 1 && t % (MINUTE ~/ 2) == MINUTE ~/ 4 && !stress {
            for _ in 8 + minute * 3 {
                Waves::spawn(horde, p, Bat::new(), 1.0);
            }
        }
    }

    // fills the screen and beyond with every kind of enemy, for the stress start
    pub fn crowd(self, horde: Horde, p: Player) {
        self.mix = Waves::mix_at(6);
        for _ in CROWD {
            let a = float::random(TAU);
            let r = 30.0 + float::random(220.0);
            let kind = self.mix.choose()!;
            horde.spawn(kind, p.pos.add(Vec2::from_angle(a).scale(r)), 1.0);
        }
    }

    // on a ring just outside the screen
    fn spawn(horde: Horde, p: Player, kind: EnemyKind, tough: float) -> enemies::Enemy {
        let a = float::random(TAU);
        let r = 165.0 + float::random(25.0);
        horde.spawn(kind, p.pos.add(Vec2::from_angle(a).scale(r)), tough)
    }

    // new kinds join in as the minutes go by
    pub fn mix_at(minute: int) -> [EnemyKind] {
        let mix: [EnemyKind] = [];
        for kind in EnemyKind::*::new() {
            let count = 0;
            for (from, share) in kind.VOTES {
                if minute >= from {
                    count = share;
                }
            }
            for _ in count {
                mix.push(kind);
            }
        }
        mix
    }
}
