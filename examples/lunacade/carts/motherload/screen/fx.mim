module fx;

use std::math::{IVec2, Vec2, ivec2, vec2};

use sprites::Sprite;

/// How many frames a popup lasts, and how many the blinds take to open.
const POPUP = 70;
const BLINDS = 12;

/// Everything in the world that's only there to be looked at.
pub struct Fx {
    sparks: [Spark],
    popups: [Popup],
    /// The frames the camera has left to shake for.
    shake: int,
    /// The frames the blinds have left to finish opening.
    blinds: int,
}

impl Fx {
    /// It starts behind shut blinds, which is how a new run or a recovered pod comes into view.
    pub fn new() -> Self {
        Self { sparks = [], popups = [], shake = 0, blinds = BLINDS }
    }

    /// Throws `count` bits of `art` up from a spot, or down from it with a negative `lift`. The art
    /// has a second frame it shrinks to.
    pub fn burst(self, at: Vec2, art: Sprite, count: int, lift = 1.0) {
        for _ in count {
            let pos = vec2(at.x, at.y);
            let vel = vec2(float::random(3.6) - 1.8, (-0.4 - float::random(1.3)) * lift);
            self.sparks.push(Spark { art, pos, vel, life = 18 + int::random(12) });
        }
    }

    /// A sparkle that stays about where it's put.
    pub fn glint(self, at: Vec2) {
        let pos = vec2(at.x, at.y);
        self.sparks.push(Spark { art = Sprite::Spark, pos, vel = vec2(0.0, -0.4), life = 14 });
    }

    /// Floats a line of text up from just over a spot. Lines that went up in the last few frames
    /// are bumped a row higher to make room, so a few at once stack with the first on top.
    pub fn popup(self, at: Vec2, text: str, color: Color) {
        for popup in self.popups {
            if popup.life > POPUP - 10 {
                popup.pos.y -= 8.0;
            }
        }
        self.popups.push(Popup { text, pos = at.sub(vec2(0.0, 13.0)), color, life = POPUP });
    }

    /// Shakes the camera for some frames, or goes on shaking it if that's already longer.
    pub fn shake(self, frames: int) {
        self.shake = self.shake.max(frames);
    }

    /// Shuts the view behind blinds, which open again over the next few frames. It covers the
    /// world jumping from one place to another.
    pub fn wipe(self) {
        self.blinds = BLINDS;
    }

    /// How far to nudge the camera this frame. A shake starts hard and settles as it runs out.
    pub fn offset(self) -> IVec2 {
        let reach = ((self.shake + 11) ~/ 12).min(3);
        ivec2(int::random(reach * 2 + 1) - reach, int::random(reach + 1))
    }

    pub fn update(self) {
        const GRAVITY = 0.07;
        self.shake = (self.shake - 1).max(0);
        self.blinds = (self.blinds - 1).max(0);
        self.sparks = for spark in self.sparks {
            spark.life -= 1;
            spark.pos = spark.pos.add(spark.vel);
            spark.vel.y += GRAVITY;
            if spark.life > 0 collect spark;
        };
        // a popup jumps up and then drifts
        self.popups = for popup in self.popups {
            popup.life -= 1;
            popup.pos.y -= 0.012 * popup.life.to_float();
            if popup.life > 0 collect popup;
        };
    }

    pub fn draw(self, view: IVec2) {
        for spark in self.sparks {
            spark.art.draw(spark.pos.to_ivec2().sub(ivec2(4, 4)), if spark.life > 9 0 else 1);
        }

        // popups are kept on screen, and outlined to read over whatever is behind them
        for popup in self.popups {
            let width = gfx::text_width(popup.text);
            let at = popup.pos.to_ivec2().sub(ivec2(width ~/ 2, 0));
            at.x = at.x.clamp(view.x + 2, view.x + luna::WIDTH - width - 2);
            for edge in [ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1), ivec2(1, 1)] {
                gfx::text(popup.text, at.add(edge), Color::Black);
            }
            gfx::text(popup.text, at, popup.color);
        }

        // the blinds are bands of the view, each shut from its middle out
        const BAND = 16;
        let shut = BAND * self.blinds ~/ BLINDS;
        for band in luna::HEIGHT ~/ BAND + 1 {
            let top = ivec2(view.x, view.y + band * BAND + (BAND - shut) ~/ 2);
            gfx::fill_rect(top, ivec2(luna::WIDTH, shut), Color::Black);
        }
    }
}

struct Spark {
    art: Sprite,
    pos: Vec2,
    vel: Vec2,
    life: int,
}

struct Popup {
    text: str,
    pos: Vec2,
    color: Color,
    life: int,
}
