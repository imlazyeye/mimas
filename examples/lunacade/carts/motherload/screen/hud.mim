module hud;

use std::math::{IVec2, ivec2};

use pod::Pod;
use run::{Run, VIEW_BOTTOM, VIEW_TOP};
use sprites::Sprite;
use widgets::{bar, flash, name, stat};

/// The gauges over the world and the lines under it. What it shows trails the real numbers by a
/// few frames, so a change can be seen happening.
pub struct Hud {
    /// How full the fuel and hull bars are drawn, from 0 to 1.
    fuel: float,
    hull: float,
    /// The cash on show, which rolls toward what the run has.
    cash: int,
    /// How many loads are in the bay, and how many of each gadget are left.
    loads: Count,
    stock: [Count],
    ticker: Ticker,
}

impl Hud {
    pub fn new() -> Self {
        Self {
            fuel = 1.0,
            hull = 1.0,
            cash = 0,
            loads = Count::new(),
            stock = [],
            ticker = Ticker::new(),
        }
    }

    /// Draws it for a run. `prompting` is whether a pod parked at a station is told what A does
    /// there, in place of what the radio last said.
    pub fn draw(self, run: Run, prompting = true) {
        let below = ivec2(luna::WIDTH, luna::HEIGHT - VIEW_BOTTOM);
        gfx::fill_rect(IVec2::zero(), ivec2(luna::WIDTH, VIEW_TOP), Color::Black);
        gfx::fill_rect(ivec2(0, VIEW_BOTTOM), below, Color::Black);
        gfx::line(ivec2(0, VIEW_TOP - 1), ivec2(luna::WIDTH - 1, VIEW_TOP - 1), Color::Slate);
        gfx::line(ivec2(0, VIEW_BOTTOM), ivec2(luna::WIDTH - 1, VIEW_BOTTOM), Color::Slate);

        self.gauges(run);
        self.cargo(run.pod);
        stat(Sprite::Depth, f"{run.depth()} FT", ivec2(74, 8), Color::White);
        goal(run);
        self.radio(run, prompting);
        self.belt(run.pod);
    }

    /// The top row: fuel, hull, heat and cash.
    fn gauges(self, run: Run) {
        let pod = run.pod;
        let (low, weak, hot) = (pod.low(), pod.weak(), pod.hot());

        let tank = pod.fuel.to_float() / pod.specs.tank.to_float();
        self.fuel += (tank - self.fuel) * 0.15;
        Sprite::Fuel.draw(ivec2(2, 0));
        bar(ivec2(12, 2), 56, tank, self.fuel, flash(low, if low Color::Red else Color::Lime));

        let whole = pod.hull.to_float() / pod.specs.hull.to_float();
        self.hull += (whole - self.hull) * 0.15;
        Sprite::Plating.draw(ivec2(74, 0));
        bar(ivec2(84, 2), 44, whole, self.hull, flash(weak, if weak Color::Red else Color::Sky));

        let heat = flash(hot, if hot Color::Red else Color::Slate);
        stat(Sprite::Thermo, f"{pod.heat}%", ivec2(136, 0), heat);

        // the cash rolls to its new figure, and is white while it does
        let owed = run.cash - self.cash;
        self.cash += if owed.abs() < 5 owed else owed ~/ 5;
        let cash = if owed == 0 Color::Yellow else Color::White;
        stat(Sprite::Coin, f"${self.cash}", ivec2(184, 0), cash);

        // any of the three being bad puts a blinking frame around the world
        if (low || weak || hot) && luna::frame() ~/ 8 % 2 == 0 {
            let view = ivec2(luna::WIDTH, VIEW_BOTTOM - VIEW_TOP);
            gfx::rect(ivec2(0, VIEW_TOP), view, Color::Red);
        }
    }

    /// How full the bay is, and what's in it is worth.
    fn cargo(self, pod: Pod) {
        let full = pod.full();
        let worth = (for mineral in pod.hold collect mineral.VALUE).sum();
        let text = f"{pod.hold.len()}/{pod.specs.bay}{if worth > 0 f" ${worth}" else ""}";
        let color = flash(full, if full Color::Orange else Color::Silver);
        let lit = self.loads.changed(pod.hold.len());
        stat(Sprite::Crate, text, ivec2(2, 8), if lit Color::White else color);
    }

    /// The line under the world: a station's prompt, or what the radio last said, or how to play.
    fn radio(self, run: Run, prompting: bool) {
        let line: str? = null;
        let color = Color::Slate;
        if let prompt? = if prompting run.docked()?.PROMPT else null {
            line = prompt;
            color = Color::Lime;
        } else if run.radio.timer > 0 {
            line = run.radio.line;
            color = flash(run.radio.urgent, Color::Yellow);
        }
        if let line? = line {
            gfx::text(self.ticker.show(line), ivec2(4, VIEW_BOTTOM + 3), color);
        }
    }

    /// The bottom row: every gadget with its button, if it has one, and how many are left.
    fn belt(self, pod: Pod) {
        for (slot, supply) in pod.supplies.enumerate() {
            if slot == self.stock.len() {
                self.stock.push(Count::new());
            }
            let text = if let button? = supply.gadget.BUTTON {
                f"{name(button)}:{supply.count}"
            } else {
                f"{supply.count}"
            };
            let color = if supply.count > 0 Color::Silver else Color::Charcoal;
            let lit = self.stock[slot].changed(supply.count);
            let at = ivec2(2 + slot * 40, VIEW_BOTTOM + 9);
            stat(supply.gadget.ICON, text, at, if lit Color::White else color);
        }
    }
}

/// The corner of the hud that says what to go after: away from the magma, or home with the
/// motherlode.
fn goal(run: Run) {
    let at = ivec2(184, 10);
    if let flood? = run.flood {
        gfx::text(f"MAGMA {flood.below(run.pod.pos)} FT", at, flash(true, Color::Orange));
    } else if run.pod.core {
        gfx::text("CORE ON BOARD!", at, Color::Cyan);
    }
}

/// A number that's drawn lit for a moment after it changes.
struct Count {
    was: int,
    lit: int,
}

impl Count {
    fn new() -> Self {
        Self { was = 0, lit = 0 }
    }

    /// Takes this frame's number, and returns whether to draw it lit.
    fn changed(self, now: int) -> bool {
        self.lit = if now != self.was 10 else (self.lit - 1).max(0);
        self.was = now;
        self.lit > 0
    }
}

/// A line of text that types itself out, starting over when the line changes.
struct Ticker {
    line: str,
    typed: int,
}

impl Ticker {
    fn new() -> Self {
        Self { line = "", typed = 0 }
    }

    /// Takes this frame's line, and returns as much of it as is typed so far.
    fn show(self, line: str) -> str {
        if line != self.line {
            self.line = line;
            self.typed = 0;
        }
        self.typed = (self.typed + 2).min(line.len());
        (for at in self.typed collect line[at]).join("")
    }
}
