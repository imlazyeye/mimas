module fx;

use std::math::{IVec2, Vec2, ivec2, vec2};

use sprites::Sprite;

const MOST_SPARKS = 64;
const MOST_POPUPS = 5;
const GRAVITY = 0.07;
const POPUP_LIFE = 70;
const POPUP_RISE = 0.15;

struct Spark {
    art: Sprite,
    pos: Vec2,
    vel: Vec2,
    life: int,
}

struct Popup {
    text: str,
    pos: Vec2,
    color: Color,
    life: int,
}

/// Everything in the world that's only there to be looked at.
pub struct Fx {
    sparks: [Spark],
    popups: [Popup],
    shake: int,
}

impl Fx {
    pub fn new() -> Self {
        Self { sparks = [], popups = [], shake = 0 }
    }

    /// Throws `count` bits of `art` up from a spot. The art has a second frame it shrinks to.
    pub fn burst(self, at: Vec2, art: Sprite, count: int) {
        for _ in count.min(MOST_SPARKS - self.sparks.len()) {
            let vel = vec2(float::random(3.6) - 1.8, -0.4 - float::random(1.3));
            self.sparks.push(Spark { art, pos = at, vel, life = 18 + int::random(12) });
        }
    }

    /// Floats a line of text up from just over a spot.
    pub fn popup(self, at: Vec2, text: str, color: Color) {
        if self.popups.len() >= MOST_POPUPS {
            self.popups.remove(0);
        }
        self.popups.push(Popup { text, pos = at.sub(vec2(0.0, 13.0)), color, life = POPUP_LIFE });
    }

    pub fn shake(self, frames: int) {
        self.shake = self.shake.max(frames);
    }

    /// How far to nudge the camera this frame.
    pub fn offset(self) -> IVec2 {
        if self.shake == 0 IVec2::zero() else ivec2(int::random(3) - 1, int::random(2))
    }

    pub fn update(self) {
        if self.shake > 0 {
            self.shake -= 1;
        }
        self.sparks = for spark in self.sparks {
            spark.life -= 1;
            spark.pos = spark.pos.add(spark.vel);
            spark.vel = spark.vel.add(vec2(0.0, GRAVITY));
            if spark.life > 0 collect spark;
        };
        self.popups = for popup in self.popups {
            popup.life -= 1;
            popup.pos = popup.pos.sub(vec2(0.0, POPUP_RISE));
            if popup.life > 0 collect popup;
        };
    }

    pub fn draw(self) {
        for spark in self.sparks {
            spark.art.draw(spark.pos.to_ivec2().sub(ivec2(4, 4)), if spark.life > 9 0 else 1);
        }
        for popup in self.popups {
            let at = popup.pos.to_ivec2().sub(ivec2(gfx::text_width(popup.text) ~/ 2, 0));
            gfx::text(popup.text, at.add(ivec2(1, 1)), Color::Black);
            gfx::text(popup.text, at, popup.color);
        }
    }
}
