module minerals;

use sprites::Sprite;

/// Something in the ground the refinery pays for. Every mineral is its own type, and
/// `Mineral::*::new()` is one of each, which is where the mine finds what to bury.
pub pact Mineral {
    /// What a find of it is announced as.
    const NAME: str;
    /// What the refinery pays for one.
    const VALUE: int;
    /// How it looks in the ground, drawn over the soil it's in.
    const ORE: Sprite;
    /// The depth in feet it starts turning up at.
    const SHALLOWEST: int;
    /// The depth in feet it runs out at, when it does.
    const DEEPEST: int? = null;
    /// How many cells in a thousand hold it between those depths.
    const ODDS: int = 125;

    fn new() -> Self;
}

pub struct Copper;
impl Mineral for Copper {
    const NAME = "COPPER";
    const VALUE = 25;
    const ORE = Sprite::Copper;
    const SHALLOWEST = 0;
    const DEEPEST = 480;

    pub fn new() -> Self {
        Self {}
    }
}

