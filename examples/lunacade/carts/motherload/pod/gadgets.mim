module gadgets;

use run::Run;
use sprites::Sprite;

/// Something the pod carries a few of, which goes off at a button or by itself. Every gadget is
/// its own type, and `Gadget::*::new()` is one of each, which is what a new pod is stocked from.
pub pact Gadget {
    /// What the hud and the depot call it.
    const NAME: str;
    /// An 8 by 8 picture of it.
    const ICON: Sprite;
    /// The button that sets one off. One without a button is tried every frame.
    const BUTTON: Button? = null;
    /// What the depot charges for one.
    const PRICE: int;
    /// What the depot says about it.
    const PERK: str;
    /// How many a new pod carries.
    const STARTING: int = 1;

    fn new() -> Self;

    /// Sets one off, and says whether it did. One that didn't isn't used up.
    fn fire(self, run: Run) -> bool;
}

/// How many of a gadget the pod has left.
pub struct Supply {
    pub gadget: Gadget,
    pub count: int,
}

struct Can;
impl Gadget for Can {
    const NAME = "BACKUP FUEL";
    const ICON = Sprite::Can;
    const PRICE = 60;
    const PERK = "FILLS TANK TO 25% WHEN IT RUNS OUT ONCE.";

    fn new() -> Self {
        Self {}
    }

    fn fire(self, run: Run) -> bool {
        let pod = run.pod;
        // a pod that coasts onto a pad on its last drop has no need of it
        if pod.fuel > 0 || run.docked() != null {
            return false;
        }
        pod.fuel = pod.specs.tank ~/ 4;
        run.fx.popup(pod.pos, "BACKUP FUEL", Color::Lime);
        true
    }
}

struct Kit;
impl Gadget for Kit {
    const NAME = "PATCH KIT";
    const ICON = Sprite::Kit;
    const PRICE = 120;
    const PERK = "REPAIRS A SMALL AMOUNT OF HULL WHEN IT BREAKS ONCE.";

    fn new() -> Self {
        Self {}
    }

    fn fire(self, run: Run) -> bool {
        let pod = run.pod;
        if pod.hull > 0 {
            return false;
        }
        pod.hull = 50.min(pod.specs.hull);
        run.fx.popup(pod.pos, "PATCH KIT", Color::Sky);
        true
    }
}

struct Teleporter;
impl Gadget for Teleporter {
    const NAME = "TELEPORTER";
    const ICON = Sprite::Teleporter;
    const BUTTON = Button::Y;
    const PRICE = 180;
    const PERK = "TELEPORTS YOU TO THE REFINERY ONCE.";

    fn new() -> Self {
        Self {}
    }

    fn fire(self, run: Run) -> bool {
        if run.pod.core {
            run.radio.say("THE MOTHERLODE JAMS THE TELEPORTER!", urgent = true);
            return false;
        }
        if !run.buried() {
            run.radio.say("CANNOT USE HERE");
            return false;
        }
        run.land();
        run.radio.say("TELEPORTED UP TO THE REFINERY.");
        true
    }
}
