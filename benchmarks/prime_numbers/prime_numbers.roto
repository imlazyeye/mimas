fn main() {
    let max: u64 = 7000000;

    let prime_mask: List[bool] = [];
    let k: u64 = 0;
    while k < max + 1 {
        prime_mask.push(true);
        k += 1;
    }

    prime_mask.push(false);
    prime_mask.swap(0, prime_mask.len() - 1);
    prime_mask.push(false);
    prime_mask.swap(1, prime_mask.len() - 1);

    let total_primes_found: i64 = 0;

    let i: u64 = 2;
    while i < max + 1 {
        let is_prime = match prime_mask.get(i) {
            Some(b) => b,
            None => false,
        };
        if is_prime {
            total_primes_found += 1;

            let n = 2 * i;
            while n < max + 1 {
                prime_mask.push(false);
                prime_mask.swap(n, prime_mask.len() - 1);
                n += i;
            }
        }
        i += 1;
    }
    print(f"{total_primes_found}");
}
