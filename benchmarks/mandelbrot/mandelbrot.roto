const WIDTH: f64 = 450.0;
const HEIGHT: f64 = 450.0;
const MAXITER: i64 = 400;

fn main() {
    let checksum: i64 = 0;
    let py = 0.0;
    while py < HEIGHT {
        let cy = py / HEIGHT * 3.0 - 1.5;
        let px = 0.0;
        while px < WIDTH {
            let cx = px / WIDTH * 3.0 - 2.0;
            let zx = 0.0;
            let zy = 0.0;
            let iter: i64 = 0;
            while zx * zx + zy * zy <= 4.0 && iter < MAXITER {
                let new_zx = zx * zx - zy * zy + cx;
                zy = 2.0 * zx * zy + cy;
                zx = new_zx;
                iter += 1;
            }
            checksum += iter;
            px += 1.0;
        }
        py += 1.0;
    }
    print(f"{checksum}");
}
