fn main() {
    let n: i64 = 4500000;

    let total_len: u64 = 0;
    let hits: i64 = 0;
    let i: i64 = 0;
    while i < n {
        let s = f"item_{i % 128}_value";
        total_len += s.bytes().len();
        if s.contains("7") {
            hits += 1;
        }
        let u = s.to_uppercase();
        total_len += u.bytes().len();
        i += 1;
    }
    print(f"{total_len}");
}
