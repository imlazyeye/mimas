(define COUNT 250)
(define STEPS 600)
(define SIZE 400.0)
(define TOUCH 8.0)

(struct ball (x y vx vy) #:mutable)

(define balls (make-vector COUNT 0))
(let loop ((i 0))
    (when (< i COUNT)
        (vector-set! balls i
            (ball (* (exact->inexact (modulo i 25)) 16.0)
                (* (exact->inexact (modulo i 17)) 23.0)
                (- (exact->inexact (modulo i 7)) 3.0)
                (- (exact->inexact (modulo i 5)) 2.0)))
        (loop (+ i 1))))

(let step ((s 0))
    (when (< s STEPS)
        ; move each ball, reversing it whenever it reaches a wall
        (let loop ((i 0))
            (when (< i COUNT)
                (let ((b (vector-ref balls i)))
                    (set-ball-x! b (+ (ball-x b) (ball-vx b)))
                    (set-ball-y! b (+ (ball-y b) (ball-vy b)))
                    (when (or (< (ball-x b) 0.0) (> (ball-x b) SIZE))
                        (set-ball-vx! b (- (ball-vx b))))
                    (when (or (< (ball-y b) 0.0) (> (ball-y b) SIZE))
                        (set-ball-vy! b (- (ball-vy b)))))
                (loop (+ i 1))))
        ; when two balls touch, swap their velocities so they bounce apart
        (let outer ((i 0))
            (when (< i COUNT)
                (let ((b (vector-ref balls i)))
                    (let inner ((j (+ i 1)))
                        (when (< j COUNT)
                            (let ((o (vector-ref balls j)))
                                (let ((dx (- (ball-x o) (ball-x b))) (dy (- (ball-y o) (ball-y b))))
                                    (when (< (sqrt (+ (* dx dx) (* dy dy))) TOUCH)
                                        (let ((tx (ball-vx b)) (ty (ball-vy b)))
                                            (set-ball-vx! b (ball-vx o))
                                            (set-ball-vy! b (ball-vy o))
                                            (set-ball-vx! o tx)
                                            (set-ball-vy! o ty)))))
                            (inner (+ j 1)))))
                (outer (+ i 1))))
        (step (+ s 1))))

(define total
    (let loop ((i 0) (acc 0.0))
        (if (< i COUNT)
            (let ((b (vector-ref balls i)))
                (loop (+ i 1) (+ acc (ball-x b) (ball-y b))))
            acc)))
(displayln total)
