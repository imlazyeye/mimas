const N = 4_000_000;
const K = 256;

// pre-build the K string keys once
let keys: [str] = array::new();
for j in K {
    keys.push(f"k{j}");
}

// build a dataset (array of bucket indices)
let data: [int] = array::new();
for i in N {
    data.push(i % K);
}

// histogram it into a dict<str, int>
let hist: ~{int} = ~{};
for x in data {
    let key = keys[x];
    if key in hist {
        hist[key] = hist[key]! + 1;
    } else {
        hist[key] = 1;
    }
}

// total across all buckets
let total = 0;
for (_, v) in hist {
    total += v;
}
print(total);
