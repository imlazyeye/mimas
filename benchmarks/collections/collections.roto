const N: u64 = 4_000_000;
const K: u64 = 256;

fn main() {
    // pre-build the K string keys once
    let keys: List[String] = [];
    let j: u64 = 0;
    while j < K {
        keys.push(f"k{j}");
        j += 1;
    }

    // build a dataset (list of bucket indices)
    let data: List[u64] = [];
    let i: u64 = 0;
    while i < N {
        data.push(i % K);
        i += 1;
    }

    // histogram it in lieu of a dict
    let hist_keys: List[String] = [];
    let hist_counts: List[i64] = [];
    for x in data {
        let key = match keys.get(x) {
            Some(s) => s,
            None => return,
        };
        match hist_keys.index(key) {
            Some(slot) => {
                let count = match hist_counts.get(slot) {
                    Some(c) => c,
                    None => return,
                };
                hist_counts.set(slot, count + 1);
            }
            None => {
                hist_keys.push(key);
                hist_counts.push(1);
            }
        }
    }

    // total across all buckets
    let total: i64 = 0;
    for count in hist_counts {
        total += count;
    }
    print(f"{total}");
}
