use std::fs;

// Formats an individual test based on the input from our regex search.
fn create_test(group: [str]) -> str {
    let snake = group[1].to_snake();
    f"tok_test!(lex_{snake}: \"{group[2]}\" => {group[1]});"
}

const PREAMBLE: str = "// THIS FILE IS AUTOGENERATED BY `tools/autogen.mim`!";
const IMPORTS: str = "use crate::lex::TokKind::*;";
const TOKEN_PATH: str = "crates/parse/src/lex/tok.rs";
const TEST_PATH: str = "crates/parse/src/tests/autogen_tok_tests.rs";
const PATTERN: str = "TokKind::(\w+) => \"(.+?)\",";

// Read the text of our token file and split it into lines
let lines = fs::read(TOKEN_PATH)!.split("\n");

// Identify our toks by collecting succesful regex matches
let searches = for line in lines {
    let search = line.find(PATTERN);
    if search != null {
        collect search;
    }
};

// Assemble the file
let output = [PREAMBLE, IMPORTS, ""];
output.extend(for group in searches collect create_test(group!));

// Spit it out!
fs::write(TEST_PATH, output.join("\n") + "\n")!;