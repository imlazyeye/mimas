use std::sys;
use std::parse;
use shiki::Shiki;

const BLOCK_PATTERN = "```mimas[ \\t]*\\r?\\n([\\s\\S]*?)\\r?\\n[ \\t]*```";

match (sys::arg(1), sys::arg(2)) {
    ("supports"?, renderer?) => sys::exit(if renderer == "html" 0 else 1),
    ("svg"?, content?) => generate_svgs(content),
    (null, _) => modify_book(),
    _ => panic("invalid comamnd"),
}

/// mdBook preprocessor entry: read the `[context, book]` payload from stdin, render every mimas code
/// block in the book to highlighted HTML, and emit the modified book back as JSON on stdout.
fn modify_book() {
    let book = parse::from_json(sys::stdin()!)!.as_array()![1];
    let parse::Value::Object(root) = book else { panic("the book isn't an object") };
    let parse::Value::Array(sections) = root["sections"] ?? parse::Value::Null else {
        panic("the book has no sections")
    };
    let chapters = chapters(sections);

    let sources = [];
    for chapter in chapters {
        for found in chapter["content"]!.as_str()!.find_all(BLOCK_PATTERN)! {
            sources.push(found[1]);
        }
    }
    let cache = ~{};
    for (i, shiki) in Shiki::from_many(sources)!.enumerate() {
        cache[sources[i]] = shiki.to_html();
    }

    for chapter in chapters {
        let content = chapter["content"]!.as_str()!;
        for found in content.find_all(BLOCK_PATTERN)! {
            content = content.replace(f"```mimas\n{found[1]}\n```", cache[found[1]]!);
        }
        chapter["content"] = parse::Value::String(content);
    }
    print(parse::to_json(book)!);
}

/// Every chapter among `items` or anywhere beneath them, as the book's own dicts so that editing
/// one edits the book.
fn chapters(items: [parse::Value]) -> [~{parse::Value}] {
    let out = [];
    for item in items {
        if let parse::Value::Object(item) = item {
            if let parse::Value::Object(chapter) = item["Chapter"] ?? parse::Value::Null {
                out.push(chapter);
                if let parse::Value::Array(sub_items) = chapter["sub_items"] ?? parse::Value::Null {
                    out.extend(chapters(sub_items));
                }
            }
        }
    }
    out
}

/// Rewrites a markdown file in-place, replacing mimas code blocks with svg renders stored in
/// ../assets.
fn generate_svgs(path: str) {
    const EMBED_PATTERN = "!\[mimas source\]\((.+)\)";
    const MIMAS_PATTERN = "<!-- mimas-source:\\n([\\s\\S]*?)\\n-->";

    let md = std::fs::read(path)!;

    for (i, line) in md.lines().enumerate() {
        if let embed? = line.find(EMBED_PATTERN) {
            if let svg? = std::fs::read(embed[1]) {
                if let source? = svg.find(MIMAS_PATTERN) {
                    std::fs::write(embed[0], Shiki::from_str(source[1])!.to_svg());
                } else {
                    print(f"Could not find mimas source in {embed[1]}");
                    continue;
                }
            }
        }
    }

    for found in md.find_all(BLOCK_PATTERN)! {
        let shiki = shiki::Shiki::from_str(found[1])!;
        let svg = shiki.to_svg();
        let out_path = f"tools/assets/sample_{int::random(9999)}.svg";
        std::fs::write(out_path, svg);
        let original = f"```mimas\n{found[0]}\n```";
        md = md.replace(original, f"![mimas source]({out_path})");
    }
    std::fs::write(path, md)!;

    for file in std::fs::list_dir("tools/assets")! {
        if (file in md) == false {
            std::fs::remove(file);
        }
    }
}