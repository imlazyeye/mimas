{
    "name": "mimas",
    "displayName": "mimas",
    "description": "Support for mimas, a flexible, statically typed scripting language for Rust.",
    "version": "0.2.0",
    "publisher": "imlazyeye",
    "author": {
        "name": "Gabe Weiner"
    },
    "license": "MIT OR Apache-2.0",
    "homepage": "https://mim.as",
    "repository": {
        "type": "git",
        "url": "https://github.com/imlazyeye/mimas.git",
        "directory": "tools/vscode"
    },
    "bugs": {
        "url": "https://github.com/imlazyeye/mimas/issues"
    },
    "icon": "icon.png",
    "galleryBanner": {
        "color": "#12141d",
        "theme": "dark"
    },
    "keywords": [
        "mimas",
        "mim",
        "language",
        "scripting",
        "syntax"
    ],
    "engines": {
        "vscode": "^1.91.0"
    },
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:mimas"
    ],
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "sync-grammar": "node ./scripts/sync-grammar.mjs",
        "vscode:prepublish": "node ./scripts/sync-grammar.mjs && node ./scripts/copy-license.mjs && npm run compile"
    },
    "contributes": {
        "languages": [
            {
                "id": "mimas",
                "aliases": [
                    "mimas"
                ],
                "extensions": [
                    ".mim"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/mimas-file-light.svg",
                    "dark": "./icons/mimas-file-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "mimas",
                "scopeName": "source.mim",
                "path": "./syntaxes/mimas.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "mimas",
                "path": "./snippets/mimas.json"
            }
        ],
        "configurationDefaults": {
            "[mimas]": {
                "editor.quickSuggestions": {
                    "other": "on",
                    "comments": "off",
                    "strings": "off"
                },
                "editor.snippetSuggestions": "top",
                "editor.suggest.showSnippets": true,
                "editor.tabCompletion": "on"
            }
        },
        "problemMatchers": [
            {
                "name": "mimas",
                "owner": "mimas",
                "source": "mimas",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": [
                    {
                        "regexp": "^(error|warning):\\s+(.*)$",
                        "severity": 1,
                        "message": 2
                    },
                    {
                        "regexp": "^\\s*\\S+\\s+(.+):(\\d+):(\\d+)\\s*$",
                        "file": 1,
                        "line": 2,
                        "column": 3
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "mimas.restartServer",
                "title": "Restart Language Server",
                "category": "mimas"
            },
            {
                "command": "mimas.selectApiManifest",
                "title": "Select Host API Manifest",
                "category": "mimas"
            }
        ],
        "configuration": {
            "title": "mimas",
            "properties": {
                "mimas.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the mimas language server executable. Empty means the one bundled with the extension, or mimas-lsp on PATH for platforms it isn't bundled for."
                },
                "mimas.apiPath": {
                    "type": "string",
                    "default": "",
                    "description": "The host API manifest a Rust host writes when run from its cargo target dir. Relative paths start from the workspace folder, empty means each script's own host (the newest mimas/<binary>.json its cargo package wrote), and off means std only. \"mimas: Select Host API Manifest\" picks one with a file dialog."
                },
                "mimas.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Log the messages exchanged with the mimas language server to the \"mimas\" output channel."
                }
            }
        }
    },
    "dependencies": {
        "vscode-languageclient": "^10.1.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/vscode": "1.74",
        "@vscode/vsce": "^4.0.0",
        "typescript": "^7.0.2"
    }
}
