use std::fs;

const OUT: str = "crates/cli/tests/doctests/main.rs";
const HEADER: str = "// generated by `tools/doctests`\n#[macro_use]\nmod harness;\n\nuse harness::Expect::*;";

// the docs are the markdown pages plus the doc comments in each crate, which feed the lsp and std
// reference
let files = for path in fs::list_dir(".")! {
    if path.ends_with(".md") collect path.find("^\\./(.*)$")![1];
};
files.extend(for path in fs::walk("book/src")! { 
    if path.ends_with(".md") collect path; 
});
for krate in fs::list_dir("crates")! {
    files.extend(for path in fs::walk(f"{krate}/src")! {
        if path.ends_with(".rs") && !path.contains("/tests/") collect path;
    });
}

let tests = [];
for path in files {
    let start: int? = null;
    let indent = "";
    let attrs = [];
    let source = [];
    for (i, line) in fs::read(path)!.lines().enumerate() {
        let text = line;
        if path.ends_with(".rs") {
            let doc? = line.find("^\\s*//[/!] ?(.*)$") else {
                if let at? = start {
                    panic(f"{path}:{at} never closes its mimas block");
                }
                continue;
            };
            text = doc[1];
        }

        if start == null {
            if let open? = text.find("^(\\s*)```mimas((?:[ \\t]+\\S+)*)[ \\t]*$") {
                start = i + 1;
                indent = open[1];
                attrs = for word in open[2].find_all("\\S+")! collect word[0];
                for attr in attrs {
                    if attr !in ["ignore", "no_run"] {
                        panic(f"{path}:{i + 1} has an unknown mimas block attribute `{attr}`");
                    }
                }
                source = [];
            }
        } else if text.trim() == "```" {
            tests.push((path, start!, attrs, source.join("\n")));
            start = null;
        } else {
            if let indented? = text.find(f"^{indent}(.*)$") {
                text = indented[1];
            }
            // a `# ` line is hidden from readers but still part of the test
            if text.trim() == "#" {
                text = "";
            } else if let hidden? = text.find("^(\\s*)# (.*)$") {
                text = hidden[1] + hidden[2];
            }
            source.push(text);
        }
    }
    if let at? = start {
        panic(f"{path}:{at} never closes its mimas block");
    }
}

let out = [HEADER];
for (path, line, attrs, source) in tests {
    let location = f"{path}:{line}";

    // a block that should fail says where with the same comment readers see
    let compile_errors = [];
    let runtime_errors = [];
    for (i, code) in source.lines().enumerate() {
        // only on a line of code, a commented out line doesn't fail
        if let marker? = code.find("^\\s*[^\\s/].*//\\s*(compile|runtime) error") {
            (if marker[1] == "compile" compile_errors else runtime_errors).push((i + 1).to_str());
        }
    }
    if !runtime_errors.is_empty() && (!compile_errors.is_empty() || "no_run" in attrs) {
        panic(f"{location} expects a runtime error it can never reach");
    }
    let expect = if "ignore" in attrs {
        "ignore"
    } else if !compile_errors.is_empty() {
        f"CompileError(&[{compile_errors.join(", ")}])"
    } else if !runtime_errors.is_empty() {
        f"RuntimeError(&[{runtime_errors.join(", ")}])"
    } else if "no_run" in attrs {
        "Checks"
    } else {
        "Runs"
    };

    let name = (for c in f"{path}_{line}".to_lower() collect if c.find("[a-z0-9]") != null c else "_")
        .join("");
    let hashes = "#";
    while f"\"{hashes}" in source {
        hashes += "#";
    }
    out.push(f"doctest!(\n    {name},\n    \"{location}\",\n    {expect},\n    r{hashes}\"{source}\"{hashes}\n);");
}
fs::write(OUT, out.join("\n\n") + "\n")!;
print(f"wrote {tests.len()} doc tests to {OUT}");
